# ==============================================================================
# A Year or Two Delicacies (AYOTD) - Environment Variables Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local:
#      cp .env.example .env.local
# 2. Replace the placeholder values with your real project keys.
# 3. NEVER commit .env.local to Git. Keep production credentials secure.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE, AUTH & STORAGE
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
#
# NEXT_PUBLIC_SUPABASE_URL:
#   The unique REST/GraphQL URL for your Supabase cloud project.
#   Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# NEXT_PUBLIC_SUPABASE_ANON_KEY:
#   The public anonymous JWT key. Safe to expose in the browser.
#   Used by client-side components to query public data subject to Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SUPABASE_SERVICE_ROLE_KEY:
#   CRITICAL: Keep strictly secret! Never prefix with NEXT_PUBLIC_.
#   Used on the server (API routes, webhook handlers) to bypass RLS for admin operations,
#   such as updating payment statuses from Safaricom webhooks and writing activity audit logs.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# ------------------------------------------------------------------------------
# 2. SAFARICOM DARAJA M-PESA STK PUSH (LIPA NA M-PESA ONLINE)
# ------------------------------------------------------------------------------
# Found in: Safaricom Daraja Developer Portal (https://developer.safaricom.co.ke/)
# Under 'My Apps' -> Click your App to view Consumer Key & Secret.
#
# DARAJA_CONSUMER_KEY:
#   API Consumer Key generated when you create an App on the Daraja portal.
DARAJA_CONSUMER_KEY=your-daraja-consumer-key

# DARAJA_CONSUMER_SECRET:
#   API Consumer Secret used with Consumer Key to generate the OAuth bearer token.
DARAJA_CONSUMER_SECRET=your-daraja-consumer-secret

# DARAJA_SHORTCODE:
#   The M-Pesa Paybill or Till number.
#   Default Daraja Sandbox test shortcode is: 174379
DARAJA_SHORTCODE=174379

# DARAJA_PASSKEY:
#   The Lipa Na M-Pesa Online passkey used to compute the base64 security password:
#   base64(Shortcode + Passkey + Timestamp).
#   For Sandbox testing, Safaricom provides:
#   bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# DARAJA_CALLBACK_URL:
#   The publicly accessible HTTPS URL where Safaricom sends payment confirmation webhooks.
#   For local testing, use ngrok or cloudflared (e.g., https://xyz.ngrok-free.app/api/payments/mpesa/callback).
#   For production, use your deployed Vercel domain (e.g., https://ayotd.vercel.app/api/payments/mpesa/callback).
DARAJA_CALLBACK_URL=https://your-domain.vercel.app/api/payments/mpesa/callback

# DARAJA_ENVIRONMENT:
#   Set to "sandbox" for development and simulated transactions.
#   Set to "production" when going live with a real Paybill/Till number.
DARAJA_ENVIRONMENT=sandbox


# ------------------------------------------------------------------------------
# 3. META WHATSAPP CLOUD API
# ------------------------------------------------------------------------------
# Found in: Meta for Developers (https://developers.facebook.com/) -> App Dashboard -> WhatsApp
#
# WHATSAPP_ACCESS_TOKEN:
#   System User access token with `whatsapp_business_messaging` permissions to send outbound
#   order confirmations, status updates, and customer receipts via WhatsApp.
WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-access-token

# WHATSAPP_PHONE_NUMBER_ID:
#   The unique ID of your WhatsApp Business phone number in the Meta Dashboard (not the raw phone number).
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id

# WHATSAPP_BUSINESS_ACCOUNT_ID:
#   The WhatsApp Business Account (WABA) ID under your Meta Business Manager.
WHATSAPP_BUSINESS_ACCOUNT_ID=your-meta-business-account-id

# WHATSAPP_VERIFY_TOKEN:
#   A secret random string you invent (e.g., ayotd_campus_webhook_2026).
#   You paste this exact same string into the Meta Webhook configuration field to verify webhook ownership.
WHATSAPP_VERIFY_TOKEN=ayotd_campus_verify_2026

# WHATSAPP_APP_SECRET:
#   Your Meta App Secret (found in App Settings -> Basic).
#   Used by AYOTD server to verify the `X-Hub-Signature-256` HMAC header on incoming webhook messages.
WHATSAPP_APP_SECRET=your-meta-app-secret


# ------------------------------------------------------------------------------
# 4. APPLICATION HOSTING & URLS
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL:
#   The root base URL of the AYOTD application.
#   Used when generating dynamic links in WhatsApp messages (e.g., customer order tracking links:
#   ${NEXT_PUBLIC_APP_URL}/track?orderId=...).
#   Local default: http://localhost:3000
#   Production: https://ayotd.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
